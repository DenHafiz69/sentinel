[Unit]
Description=Sentinel - Hermes web chat
After=network-online.target
Wants=network-online.target

[Service]
ExecStart=%h/sentinel/bin/webchat
Environment=CF_ACCESS_TEAM=your-team-name
# Cloudflare generates a hex AUD tag per Access application; copy it from the
# app settings. It is NOT the domain.
Environment=CF_AUD=your-app-aud-tag
# WEBCCHAT_DEV=1 would disable the Access JWT gate. Never set it while the
# tunnel is live: that would publish the chat unauthenticated.
Restart=always
RestartSec=3

[Install]
WantedBy=default.target
